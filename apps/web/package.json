{
  "name": "@datspace/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node scripts/copy-supersonic.ts && svelte-kit sync && vite dev",
    "build": "node scripts/copy-supersonic.ts && svelte-kit sync && vite build",
    "preview": "pnpm build && wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "synthdefs": "node --disable-warning=ExperimentalWarning scripts/synthdefs.ts"
  },
  "dependencies": {
    "@datspace/clock": "workspace:*",
    "@datspace/content": "workspace:*",
    "@datspace/contract": "workspace:*",
    "@datspace/fm": "workspace:*",
    "@threlte/core": "^8.6.1",
    "marked": "^18.1.1",
    "p5": "2.3.4",
    "supersonic-scsynth": "0.91.0",
    "supersonic-scsynth-core": "0.91.0",
    "three": "^0.186.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/three": "^0.186.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  }
}
