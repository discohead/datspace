{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datspace-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  // At launch the Ledger lives here; after launch it moves to the datspace-actors Worker.
  "exports": {
    "Ledger": { "type": "durable-object", "storage": "sqlite" },
    "Inbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [
      { "name": "LEDGER", "class_name": "Ledger" },
      { "name": "INBOX", "class_name": "Inbox" }
    ]
  },
  // transmit emails Jared from one address. The destination is the INBOX_TO secret, so it isn't in the repo.
  "send_email": [{ "name": "MAIL", "allowed_sender_addresses": ["transmit@datspace.io"] }],
  // CI deploys with --var COMMIT:<sha>, so the Worker and the Ledger can report which code they run.
  "vars": { "COMMIT": "dev" },
  // /mcp and /api/*: 120 requests a minute per client, per location.
  "ratelimits": [{ "name": "AGENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // Human pages on datspace.ai are served by datspace-web.
  "services": [{ "binding": "WEB", "service": "datspace-web" }],
  // datspace.ai, plus the unlit domains, which this Worker redirects to datspace.io.
  // (On datspace-web, static assets would be served before any redirect code ran.)
  "routes": [
    { "pattern": "datspace.ai", "custom_domain": true },
    { "pattern": "datspace.dev", "custom_domain": true },
    { "pattern": "datspace.fm", "custom_domain": true },
    { "pattern": "datspace.music", "custom_domain": true },
    { "pattern": "datspace.studio", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
