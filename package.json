{
  "name": "datspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "test": "pnpm -r test",
    "verify:ledger": "node --disable-warning=ExperimentalWarning scripts/verify-ledger.ts",
    "check:a11y": "node --disable-warning=ExperimentalWarning scripts/check-a11y.ts"
  },
  "devDependencies": {
    "@datspace/contract": "workspace:*",
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
